# Serves the built SPA. TLS and the /api proxy are handled by the edge proxy (infra/caddy).
# Page requests are filled in by the backend (docs/adr/013-pages-filled-in-by-the-backend.md).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 'unsafe-inline' for styles is needed for React style attributes; scripts stay strict.
		# Stripe (card payment page, ADR-010): Stripe.js from js.stripe.com, its card form and the
		# 3-D Secure check in frames from js.stripe.com / hooks.stripe.com, calls to api.stripe.com.
		# Add PayPal's hosts when PayPal is built.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://js.stripe.com https://*.js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.stripe.com; font-src 'self'; connect-src 'self' https://api.stripe.com; frame-src https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	# Hashed build assets can be cached forever; pages and index.html must always be revalidated.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@document not path /assets/*
	header @document Cache-Control "no-cache"

	# A page (a path without a file extension): the backend fills in its head, text and data.
	# If the backend answers 5xx or cannot be reached, the plain index.html is served instead.
	@page {
		method GET HEAD
		not path *.*
	}
	handle @page {
		reverse_proxy {$PAGES_BACKEND:backend:8080} {
			rewrite /_pages{uri}
			# Pages are the same for everyone: no cookies to the backend, none back.
			header_up -Cookie
			header_down -Set-Cookie
			# Set above for every response; not twice.
			header_down -Cache-Control
			header_down -X-Content-Type-Options
			header_down -X-Frame-Options
			header_down -Referrer-Policy
			@unavailable status 5xx
			handle_response @unavailable {
				rewrite * /index.html
				file_server
			}
		}
	}

	# Files (paths with an extension). A missing one answers 404: with the app's "not found"
	# page, except for build assets, where a page would only confuse the browser.
	handle {
		file_server
	}

	handle_errors 404 {
		@notAsset not path /assets/*
		handle @notAsset {
			rewrite * /index.html
			file_server
		}
	}

	handle_errors 502 503 504 {
		rewrite * /index.html
		file_server
	}
}

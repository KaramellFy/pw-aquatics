# Production settings for docker-compose.prod.yml (docs/OPERATIONS.md).
# On the server: cp .env.production.example .env, fill in, then `chmod 600 .env`.
# Never commit the filled-in file, paste it into chat or send it by email.

# Plain `docker compose …` commands on the server then use the production stack.
COMPOSE_FILE=docker-compose.prod.yml

# --- Domain and HTTPS --------------------------------------------------------------
# The shop's address without https:// (its DNS A/AAAA record must point at this server).
SHOP_DOMAIN=
# Let's Encrypt writes here about the certificate (e.g. if renewing keeps failing).
ACME_EMAIL=

# --- Database ------------------------------------------------------------------------
POSTGRES_DB=pwaquatics
POSTGRES_USER=pwaquatics
# A long random password: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Secrets the application keeps encrypted -----------------------------------------
# 32 random bytes, base64: openssl rand -base64 32
# Encrypts the administrators' two-factor keys. Keep a copy in a password manager: without
# it, administrators must set up two-factor sign-in again.
APP_ENCRYPTION_KEY=

# --- First administrator ------------------------------------------------------------
# Creates the first administrator on the first start if none exists. Remove both lines
# after signing in for the first time; the password is not needed here afterwards.
APP_ADMIN_BOOTSTRAP_EMAIL=
APP_ADMIN_BOOTSTRAP_PASSWORD=

# --- Email --------------------------------------------------------------------------
# The mail provider's SMTP server (port 587 with STARTTLS). Set up SPF, DKIM and DMARC for the
# sender's domain as described in docs/OPERATIONS.md, or emails land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender of every email, e.g. PW Aquatics <shop@your-domain>
MAIL_FROM=
# Where contact-form messages and payment problems are sent
SHOP_INBOX_EMAIL=

# --- Payment by bank transfer -------------------------------------------------------
# Without an IBAN no orders can be placed.
BANK_ACCOUNT_HOLDER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# --- Card payments (Stripe), optional ------------------------------------------------
# Live keys from the Stripe Dashboard. The webhook secret belongs to the endpoint
# https://<SHOP_DOMAIN>/api/v1/webhooks/stripe (events listed in docs/OPERATIONS.md).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal, optional ---------------------------------------------------------------
# The live REST app; webhook registered for https://<SHOP_DOMAIN>/api/v1/webhooks/paypal.
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Sign in with Google, optional ----------------------------------------------------
# Redirect URI in the Google Cloud console: https://<SHOP_DOMAIN>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Backups ------------------------------------------------------------------------
# Daily at this time (Europe/Berlin), kept this many days, written to this folder on the server.
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_DIR=./backups
# Optional: a monitoring URL (e.g. a healthchecks.io check) called after every backup, and
# "<url>/fail" when one fails, so a missing backup raises an alert.
BACKUP_PING_URL=

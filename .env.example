# Copy to .env for local development. Never commit .env.
# Production values are set in the deployment environment, not in files.

# --- Database ------------------------------------------------------------------
POSTGRES_DB=pwaquatics
POSTGRES_USER=pwaquatics
# Local-only password; choose your own. Production uses a strong generated secret.
POSTGRES_PASSWORD=nishabisha

# --- Application ---------------------------------------------------------------
# dev = demo data + API docs + non-secure cookies over http://localhost
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:5173
# Must be true in production (HTTPS)
APP_COOKIE_SECURE=false

# Optional: creates the first administrator at startup if no administrator exists yet.
# Use a strong, unique password (min. 10 characters) and remove both values afterwards.
APP_ADMIN_BOOTSTRAP_EMAIL=
APP_ADMIN_BOOTSTRAP_PASSWORD=

# --- Email -----------------------------------------------------------------------
# Locally, Mailpit catches every email: http://localhost:8025
MAIL_FROM=PW Aquatics <no-reply@localhost>
# Where contact-form messages are delivered
SHOP_INBOX_EMAIL=shop@localhost
# Production SMTP (leave empty locally; compose points the API at Mailpit)
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Orders and payment by bank transfer ---------------------------------------------
# The shop's bank account, shown to customers after ordering and in the order email.
# Leave commented out locally: the dev profile then uses an obviously fake account.
# In production all orders are refused until BANK_ACCOUNT_HOLDER and BANK_IBAN are set.
# BANK_ACCOUNT_HOLDER=
# BANK_IBAN=
# BANK_BIC=
# BANK_NAME=
# Days a bank-transfer order waits for its payment before it is cancelled (default 7).
# ORDER_BANK_TRANSFER_PAYMENT_DAYS=7
# Days needed before a parcel can leave (default 1: ordered today, earliest dispatch tomorrow).
# SHIPPING_HANDLING_DAYS=1

# --- Later phases ------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
